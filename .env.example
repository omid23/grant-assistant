# Copy to .env (or set in your deployment) to override defaults. Every variable is optional.
# The service does not load .env itself: export these, or pass them with `docker run --env-file .env`.
# Keep comments on their own lines: env files do not support comments after a value.

# HTTP port. Review scripts set this.
PORT=3000

# Model: "fake" (default, deterministic, no network) or "anthropic" (needs ANTHROPIC_API_KEY).
MODEL=fake
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Fake model only: "slow" (answers after 120 s), "loop" (never stops asking for tools),
# "unknown-tool" (asks for a tool that does not exist). Empty = normal.
FAKE_MODE=
# Fake model's context window in characters (default 6000).
# FAKE_CONTEXT_CHARS=6000

# Model calls per request. A tool asked for on the last step is refused.
MAX_STEPS=6
# Time limit for the whole request. A slower model is abandoned and the user gets a reply.
REQUEST_TIMEOUT_MS=10000

# Context budget in characters, measured the way the model measures.
# Defaults to the model's own limit (6000 for the fake).
# CONTEXT_BUDGET_CHARS=6000
# Longer messages get a reply asking to shorten them.
MAX_MESSAGE_CHARS=1000
# A tool result is trimmed to this before it goes to the model.
MAX_TOOL_RESULT_CHARS=1800
# Room kept for the question the assistant is waiting on.
PENDING_RESERVE_CHARS=650

# Excerpts per document search, and the maximum characters per excerpt.
SEARCH_TOP_K=3
CHUNK_CHARS=400

# Largest accepted request body.
MAX_BODY_BYTES=65536

# Where data is read from, and where conversations, proposals, applications and the audit log
# are written. Mount STATE_DIR on a persistent volume in production. One server per STATE_DIR.
DATA_DIR=./data
STATE_DIR=./var

# Deadlines are compared with the local date: set TZ to the communities' timezone.
TZ=America/Toronto
# Pin "today" (YYYY-MM-DD) for demos and reproducible checks. Leave unset in production.
# TODAY=2026-11-05

# info (default), error, or silent.
LOG_LEVEL=info
